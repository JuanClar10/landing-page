{
  "name": "la-postreria-cafe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.ts --dev",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "fudo:check": "node --env-file-if-exists=.env server/check-fudo.ts",
    "wiki:check": "node scripts/check-wiki.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
